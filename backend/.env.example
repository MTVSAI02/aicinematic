APP_NAME=Mongsil Bookstore API
APP_ENV=local
FRONTEND_URL=http://localhost:5173
STORAGE_DIR=app/storage

# 우리 AI FastAPI 서버 (캐릭터/배경 생성 위임).
# Backend는 {AI_SERVER_URL}/generate-character, /generate-background 를 호출한다.
# 형식: http://<AI_SERVER_HOST>:<PORT>  (실제 주소는 팀에서 공유, 로컬 .env 에만 기입)
AI_SERVER_URL=

# Voice input page: POST /api/voices/clone sends multipart audio to this server.
# Required for actual voice cloning/sample preview in /voice-input.
# This is NOT the same as AI_TTS_URL.
AI_VOICE_CLONE_URL=

# Voice page: read-only ComfyUI connection check used by /api/ai/voice-comfy-health.
# Set this only when this backend can directly reach the voice ComfyUI server.
COMFYUI_VOICE_URL=

# Optional scene TTS integration.
# If AI_TTS_URL is set, backend sends POST {AI_TTS_URL}/tts following TTS_AI_CONTRACT.md.
# Current frontend flow uses /voice-input and /voice; this remains for backend /api/tts/scene tests.
AI_TTS_URL=
AI_TTS_TIMEOUT_SEC=120

# Local development fallback for Kim Doyeon's Qwen3-TTS setup.
# Keep disabled for teammates who have not installed Qwen locally.
QWEN_TTS_ENABLED=0

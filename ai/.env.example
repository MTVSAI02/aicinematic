# ComfyUI 연동 환경변수 예시
# 코드에 URL을 하드코딩하지 않고 환경변수로 관리한다.
# 사용: 이 파일을 복사해 ai/.env 로 만든 뒤 값을 채운다.
#   cp ai/.env.example ai/.env
# 실행 시 uv의 --env-file 로 주입할 수 있다.
#   uv run --env-file ai/.env python ai/test_comfy_connection.py

# 캐릭터 쪽 ComfyUI (원격, 리눅스 GPU 서버)
COMFYUI_CHARACTER_URL=https://comfy1.mtvs2026.work

# 보이스 쪽 ComfyUI
COMFYUI_VOICE_URL=https://comfy0.mtvs2026.work

# 클라이언트가 기본으로 사용하는 URL (ComfyUIClient base_url 미지정 시 사용)
COMFYUI_DEFAULT_URL=https://comfy1.mtvs2026.work

# 요청 timeout (초). 미설정 시 기본값 10초.
COMFYUI_TIMEOUT_SECONDS=10

# 내부망에서 테스트할 경우 DEFAULT_URL을 아래처럼 바꿔 사용한다.
# COMFYUI_DEFAULT_URL=http://192.168.0.35:8188

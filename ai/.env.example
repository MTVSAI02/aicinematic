# ComfyUI common settings
COMFYUI_DEFAULT_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_SECONDS=30

# Voice/TTS ComfyUI adapter settings.
# Set to 1 to test backend/frontend wiring without ComfyUI.
TTS_ADAPTER_MOCK=0

# Run voice ComfyUI separately, usually on GPU 1:
#   CUDA_VISIBLE_DEVICES=1 python main.py --listen 0.0.0.0 --port 8189
COMFYUI_VOICE_URL=http://127.0.0.1:8189
COMFYUI_TTS_WORKFLOW_PATH=/path/to/qwen3_tts_workflow_api.json
COMFYUI_TTS_MAPPING_PATH=/path/to/qwen3_tts_mapping.json
# Optional but recommended: voiceId -> speaker/refAudio/refText mapping.
COMFYUI_TTS_VOICE_MAP_PATH=/path/to/qwen3_tts_voice_map.json
COMFYUI_TTS_OUTPUT_DIR=/path/to/ComfyUI/output/qwen3_tts
COMFYUI_TTS_TIMEOUT_SECONDS=600
COMFYUI_TTS_POLL_INTERVAL_SECONDS=2

# Public URL of this adapter server for teammate browsers.
# Example: http://192.168.0.23:8100
AI_TTS_PUBLIC_BASE_URL=
